# =====================================================================
# HireSphere — environment configuration
# Copy to `.env` (git-ignored) and adjust. The stack runs fully with
# these defaults; real keys are optional (see notes below).
# =====================================================================

# ---- JWT ----
JWT_SECRET=change-me-dev-secret-at-least-64-bytes-long-0123456789abcdefghijklmnop
JWT_ACCESS_TTL=900000            # 15 minutes (ms)
JWT_REFRESH_TTL=604800000        # 7 days (ms)

# ---- PostgreSQL ----
POSTGRES_USER=hiresphere
POSTGRES_PASSWORD=hiresphere

# ---- Google Gemini (optional) ----
# Leave GEMINI_API_KEY blank to use the built-in deterministic mock AI client.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Razorpay (optional) ----
# Leave blank to disable payments (endpoints return 503, checkout hidden).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Mail (defaults target the Mailpit dev container) ----
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@hiresphere.local

# ---- Seeded admin account ----
ADMIN_EMAIL=admin@hiresphere.local
ADMIN_PASSWORD=Admin@12345

# ---- Frontend / CORS ----
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
